{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // node: the web server sources behind AppRouter use node: modules.
    "types": ["node", "vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      // Web sources for desktop code: AppRouter types and Zod schemas.
      "@env": ["../web/src/env.ts"],
      "@server/*": ["../web/src/server/*"],
      // Only for the web files' own imports (resolved with these paths when
      // desktop typechecks AppRouter). Desktop code uses @env / @server/*.
      "@/env": ["../web/src/env.ts"],
      "@/server/*": ["../web/src/server/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
