{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rehearse",
  "version": "../package.json",
  "identifier": "app.rehearse.desktop",
  "build": {
    "beforeDevCommand": "bun run praat:fetch && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run praat:fetch && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rehearse",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage", "deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/praat"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hanzlah101/rehearse/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQjEyQjNENDBFRjIwRTYKUldUbUlPOUFQU3V4UDNCWDE5ZHk3VzJCRUhBeFpiODZRSGk0a1ZDMDJITXJoUE4xdXQvcDd5UmwK",
      "requireSignedVersion": true
    }
  }
}
